From 6aa0dc8d1dc1d9cc29af183fe9aaa250d4a61b9d Mon Sep 17 00:00:00 2001
From: cbqri <cbqri@localhost>
Date: Fri, 18 Sep 2026 14:54:02 -0400
Subject: [PATCH 1/2] iommu: enable IOMMU_DMA on RISC-V

Without IOMMU_DMA the core cannot use IOMMU_DOMAIN_DMA and forces every
default domain to IDENTITY (iommu_get_default_domain_type()), so the
RISC-V IOMMU probes but never translates DMA-API traffic: the kernel
prints 'Default domain type: Translated' while every group is identity.

The DMA ops wiring is done by the IOMMU core (iommu_setup_dma_ops()), so
no arch hooks are needed.

Device MSIs then need a mapping too; see the next patch.
---
 drivers/iommu/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/iommu/Kconfig b/drivers/iommu/Kconfig
index 6e07bd694..b0d8c7976 100644
--- a/drivers/iommu/Kconfig
+++ b/drivers/iommu/Kconfig
@@ -151,7 +151,7 @@ config OF_IOMMU
 
 # IOMMU-agnostic DMA-mapping layer
 config IOMMU_DMA
-	def_bool ARM64 || X86 || S390
+	def_bool ARM64 || X86 || S390 || RISCV
 	select DMA_OPS_HELPERS
 	select IOMMU_API
 	select IOMMU_IOVA
