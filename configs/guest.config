# Kernel config fragment merged on top of riscv defconfig.
# Everything the guest needs to boot is built in (=y): the Debian rootfs carries
# no modules for this kernel.

# --- RISC-V IOMMU, translated DMA by default --------------------------------
# Strict mode unmaps and invalidates the IOTLB synchronously, so the per-I/O
# PTE-write and invalidation counts are deterministic. Use iommu.strict=0 on the
# kernel command line to compare against lazy (batched) flushing.
CONFIG_IOMMU_SUPPORT=y
CONFIG_RISCV_IOMMU=y
CONFIG_RISCV_IOMMU_PCI=y
# Without IOMMU_DMA the core forces every default domain to IDENTITY, whatever
# the DEFAULT_DMA_* choice below says. Upstream (as of 7.3-rc) doesn't enable it
# for RISC-V; patches/linux/0001 does. This line makes an unpatched tree fail
# the kconfig check instead of silently running in passthrough.
CONFIG_IOMMU_DMA=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
CONFIG_IOMMU_DEBUGFS=y

# --- Devices under test -----------------------------------------------------
CONFIG_PCI=y
CONFIG_PCI_IOV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_E1000E=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y

# --- cgroup v2 ownership plumbing --------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_CGROUP_BPF=y

# --- eBPF / tracing for Stage 0 ----------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# Otherwise net.core.bpf_jit_enable defaults to 0 and bpftrace programs that
# need the JIT fail to load ("requires BPF JIT compiler but it is not available").
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_IKHEADERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y

# Trim build time: no graphics/sound in a headless guest.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
